{
  "global": {
    "scrape_interval": "5s",
    "evaluation_interval": "5s"
  },
  "rule_files": [
    "/etc/prometheus/rules/platform.json"
  ],
  "scrape_configs": [
    {
      "job_name": "prometheus",
      "static_configs": [
        {
          "targets": [
            "127.0.0.1:9090"
          ]
        }
      ]
    },
    {
      "job_name": "platform_nodes",
      "static_configs": [
        {
          "targets": [
            "10.1.1.205:9100"
          ],
          "labels": {
            "node": "healer-ubuntu"
          }
        },
        {
          "targets": [
            "10.1.1.50:9100"
          ],
          "labels": {
            "node": "monitor"
          }
        },
        {
          "targets": [
            "10.1.1.80:9100"
          ],
          "labels": {
            "node": "k8s-control"
          }
        },
        {
          "targets": [
            "10.1.1.81:9100"
          ],
          "labels": {
            "node": "k8s-worker-1"
          }
        },
        {
          "targets": [
            "10.1.1.82:9100"
          ],
          "labels": {
            "node": "k8s-worker-2"
          }
        },
        {
          "targets": [
            "10.1.1.84:9100"
          ],
          "labels": {
            "node": "probe-1"
          }
        }
      ]
    },
    {
      "job_name": "platform_agent",
      "static_configs": [
        {
          "targets": [
            "10.1.1.80:30919"
          ]
        }
      ]
    },
    {
      "job_name": "platform_controller",
      "static_configs": [
        {
          "targets": [
            "10.1.1.80:30885"
          ]
        }
      ]
    },
    {
      "job_name": "platform_api_ready",
      "metrics_path": "/probe",
      "params": {
        "module": [
          "k3s_ready"
        ]
      },
      "static_configs": [
        {
          "targets": [
            "https://10.1.1.80:6443/readyz"
          ]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "__address__"
          ],
          "target_label": "__param_target"
        },
        {
          "target_label": "__address__",
          "replacement": "127.0.0.1:9115"
        }
      ]
    }
  ]
}
