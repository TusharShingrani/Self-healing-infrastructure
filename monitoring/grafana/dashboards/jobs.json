{
  "uid": "selfheal-jobs",
  "title": "Bank statements: customer outcome and MAPE-K recovery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Are customer statements correct and timely?",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "job_client_healthy",
          "refId": "A",
          "legendFormat": "{{check}}{{deployment}}{{pod}}{{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Managed infrastructure contract",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "job_healer_healthy",
          "refId": "A",
          "legendFormat": "{{check}}{{deployment}}{{pod}}{{node}}"
        }
