      "type": "stat",
      "title": "Age of last completed monitor cycle (seconds)",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "time() - healer_infrastructure_last_tick_seconds",
          "refId": "A",
          "legendFormat": "{{check}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Pending advisory answers (not repair approval)",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "healer_infrastructure_advisor_pending",
          "refId": "A",
          "legendFormat": "{{check}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "tags": [
    "MAPE-K",
    "infrastructure"
  ]
}
