{
 "uid": "selfheal-mapek",
 "title": "Self-healing infrastructure (MAPE-K)",
 "tags": [
  "mape-k",
  "self-healing"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "schemaVersion": 39,
 "editable": false,
 "annotations": {
  "list": [
   {
    "name": "Loop events",
    "enable": true,
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "iconColor": "purple",
    "expr": "changes(healer_loop_events_total[20s]) > 0",
    "step": "10s",
    "titleFormat": "{{kind}}",
    "textFormat": "{{node}}: {{kind}} {{cause}}",
    "useValueForTime": false
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview: is the infrastructure serving, and what is the loop doing",
   "id": 1,
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   }
  },
  {
   "type": "stat",
   "title": "Service as a user sees it (/healthz)",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Blackbox request from the monitor instance. The body must be exactly ok.",
   "gridPos": {
    "h": 4,
    "w": 6,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "probe_success{job=\"healthz\"}",
     "legendFormat": "{{node}}",
     "refId": "A",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "DOWN",
         "color": "red"
        },
        "1": {
         "text": "UP",
         "color": "green"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "justifyMode": "center",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "type": "stat",
   "title": "Loop health verdict",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
