{
  "uid": "platform-mapek",
  "title": "HAProxy gateway - MAPE-K recovery",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "gateway",
    "mapek"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Does the independent client receive the correct HTTP response?",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_gateway_transaction_success",
          "legendFormat": "{{__name__}} {{target}} {{node}} {{status}} {{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Independent client transaction latency (seconds)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_gateway_transaction_latency_seconds",
          "legendFormat": "{{__name__}} {{target}} {{node}} {{status}} {{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Gateway port capacity, occupancy and active backend connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"platform_resource_(used_ports|range_size|active_connections)\",target=\"gateway-ports\"}",
          "legendFormat": "{{__name__}} {{target}} {{node}} {{status}} {{job}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Gateway, upstream and independent client health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"platform_resource_(upstream_healthy|gateway_transaction_ok|client_transaction_ok)\",target=\"gateway-ports\"}",
          "legendFormat": "{{__name__}} {{target}} {{node}} {{status}} {{job}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "HAProxy HTTP 5xx and backend-connect errors (cumulative)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"platform_resource_(gateway_5xx|backend_connect_errors)\",target=\"gateway-ports\"}",
          "legendFormat": "{{__name__}} {{target}} {{node}} {{status}} {{job}}"
        }
      ]
    },
    {
      "id": 6,
