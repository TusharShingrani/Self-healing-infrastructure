      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "platform_resource_allocation_probe_errno{target=\"gateway-ports\"}",
          "legendFormat": "{{__name__}} {{target}} {{node}} {{status}} {{job}}"
        }
      ]
    },
    {
