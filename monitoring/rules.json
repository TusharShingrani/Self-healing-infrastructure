{
  "groups": [
    {
      "name": "gateway",
      "rules": [
        {
          "alert": "PlatformTelemetryUnavailable",
          "expr": "up{job=~\"platform_.*\"} == 0",
          "for": "20s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Required platform telemetry is unreachable"
          }
        },
        {
          "alert": "PlatformSampleStale",
          "expr": "platform_sample_fresh{target=\"gateway-ports\"} == 0",
          "for": "15s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Gateway evidence stale; do not infer health"
          }
        },
        {
          "alert": "PlatformBrokerUnavailable",
          "expr": "platform_agent_broker_up == 0",
          "for": "10s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Native broker unreachable"
          }
        },
        {
          "alert": "PlatformLoopStalled",
          "expr": "platform_controller_loop_fresh == 0",
          "for": "10s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "MAPE-K controller not completing ticks"
          }
        },
        {
          "alert": "GatewayClientTransactionFailed",
          "expr": "platform_gateway_transaction_success == 0",
          "for": "10s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Independent HTTP transaction through HAProxy is failing"
          }
        },
        {
          "alert": "GatewayUpstreamUnavailable",
          "expr": "platform_resource_upstream_healthy{target=\"gateway-ports\"} == 0",
          "for": "10s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Upstream unavailable; increasing ports is not an eligible repair"
          }
        },
        {
          "alert": "GatewayRollbackNeedsReview",
          "expr": "platform_broker_operations{status=~\"rollback_deferred|conflict|identity_changed\"} > 0",
          "for": "20s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Inspect lease reconciliation history"
          }
        },
        {
          "alert": "GatewayApprovalPending",
          "expr": "platform_incidents{status=\"pending\"} > 0",
          "for": "30s",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Gateway incident awaits investigation or approval"
          }
        },
        {
          "alert": "PlatformHostMemoryPressure",
          "expr": "node_memory_MemAvailable_bytes{job=\"platform_nodes\"}/node_memory_MemTotal_bytes{job=\"platform_nodes\"}<0.15",
          "for": "1m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Host memory headroom below the gateway admission threshold"
          }
        }
      ]
    }
  ]
}
