#!/usr/bin/env bash
# Publishes the lab-specific facts that node_exporter cannot see, through its
# textfile collector. Runs as root from a timer, because checking the nginx
# configuration needs root.
#
#   healer_config_correct           1 when the live config is valid and equals the reference
#   healer_rotation_policy_present  1 when the rotation policy exists (the fault removes it)
#   healer_log_mount_ok             1 when the mount guard accepts the bounded log volume
#   healer_logflood_active          1 when the fault generator timer is running
#
# A check that cannot run reports 0, never 1, so unknown is never published as good.
set -uo pipefail
export LC_ALL=C

DIR=${HEALER_TEXTFILE_DIR:-/var/lib/prometheus/node-exporter}
CONFIG=${HEALER_CONFIG_PATH:-/etc/nginx/conf.d/healer.conf}
REFERENCE=${HEALER_REFERENCE_DIR:-/opt/healer/reference}
POLICY=${HEALER_ROTATION_POLICY:-/etc/logrotate.d/nginx-healer}
MOUNT=${HEALER_LOG_MOUNT:-/var/log/nginx}
IMAGE=${HEALER_LOG_IMAGE:-/var/lib/healer/nginx-logs.img}
MAX_MB=${HEALER_LOG_MAX_MB:-1024}
GUARD=${HEALER_GUARD:-/usr/local/sbin/healer-mount-guard}

flag () { if "$@" >/dev/null 2>&1; then echo 1; else echo 0; fi; }

config=$(flag bash -c "nginx -t && diff -q '$CONFIG' '$REFERENCE/healer.conf'")
policy=$(flag test -f "$POLICY")
mount=$(flag "$GUARD" "$MOUNT" "$IMAGE" "$MAX_MB" ext4)
flood=$(flag systemctl is-active --quiet healer-logflood.timer)

mkdir -p "$DIR"
TMP=$(mktemp "$DIR/.healer.prom.XXXXXX")
cat > "$TMP" <<PROM
# HELP healer_config_correct Live nginx config is valid and equals the reference.
# TYPE healer_config_correct gauge
healer_config_correct $config
# HELP healer_rotation_policy_present The audit log rotation policy exists.
# TYPE healer_rotation_policy_present gauge
healer_rotation_policy_present $policy
# HELP healer_log_mount_ok The bounded log volume passes the mount guard.
# TYPE healer_log_mount_ok gauge
healer_log_mount_ok $mount
# HELP healer_logflood_active The lab fault generator is running.
# TYPE healer_logflood_active gauge
healer_logflood_active $flood
# HELP healer_metrics_timestamp_seconds When these facts were last measured.
# TYPE healer_metrics_timestamp_seconds gauge
healer_metrics_timestamp_seconds $(date +%s)
PROM
chmod 644 "$TMP"
mv "$TMP" "$DIR/healer.prom"
